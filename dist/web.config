<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Revalidate HTML, modules, styles, data and brand assets on each visit.
           IIS can return 304 for unchanged files, without downloading again. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
  <location path="train-images">
    <system.webServer>
      <staticContent>
        <!-- Downloaded catalogue photos have stable hashed filenames. -->
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
